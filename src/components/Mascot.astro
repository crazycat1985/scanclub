---
// A small line drawing of each area's best-known ultrasound sign, matched by the
// area's file name. An area without its own drawing gets the ScanClub fan, so a
// new area never needs code. Purely decorative, so screen readers skip it.
interface Props {
  area: string;
  asleep?: boolean; // grey, eyes shut, "z z": for coming-soon areas
  flying?: boolean; // no tile, for the full-marks fly-past (the gull is just its wings)
}
const { area, asleep = false, flying = false } = Astro.props;

// The signs: aorta is the seagull (coeliac trunk's wings over the round aorta),
// gallbladder is Mickey Mouse (portal vein face, bile duct and artery ears),
// lungs is the bat (two ribs over the dotted pleural line), leg-veins is the
// probe squashing the vein flat next to the round artery, and fan is the app icon.

// Where the "z z" sits for each drawing: [x, y] of the big z, then the small one.
const zz: Record<string, [number, number, number, number]> = {
  aorta: [41, 10, 44.5, 5.5],
  gallbladder: [41, 10, 44.5, 5.5],
  lungs: [39, 11, 43, 6],
  heart: [40, 8, 44, 4],
  'leg-veins': [4, 14, 9, 9],
  fan: [38, 12, 42, 7],
};
const sign = area in zz ? area : 'fan';
const [zx, zy, sx, sy] = zz[sign];
---

{flying && sign === 'aorta' ? (
  <svg class="mascot wings" width="64" height="40" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M6 22 Q18 4 32 24 Q46 4 58 22" />
  </svg>
) : (
  <span class:list={[flying ? 'flyer' : 'tile', { asleep }]} aria-hidden="true">
    <svg class="mascot" width={flying ? 40 : 42} height={flying ? 40 : 42} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width={asleep ? 2 : 2.2} stroke-linecap="round" stroke-linejoin="round">
      {sign === 'aorta' && (
        <>
          <path d="M8 19 Q15 9 24 20 Q33 9 40 19" />
          <path d="M24 20 V26" />
          <circle cx="24" cy="33" r="7" />
        </>
      )}
      {sign === 'gallbladder' && (
        <>
          <circle cx="24" cy="30" r="10" />
          <circle cx="13.5" cy="17" r="5.5" />
          <circle cx="34.5" cy="17" r="5.5" />
          {asleep ? (
            <><path d="M18.5 29 q2 2 4 0" /><path d="M25.5 29 q2 2 4 0" /></>
          ) : (
            <><circle class="eye" cx="20.5" cy="29.5" r="1.4" /><circle class="eye" cx="27.5" cy="29.5" r="1.4" /></>
          )}
        </>
      )}
      {sign === 'lungs' && (
        <>
          <path d="M5 23 C9 16 15 15 18.5 18.5 L21 14 L24 17 L27 14 L29.5 18.5 C33 15 39 16 43 23 C39 22 36 24 35 28 C32 25 29 26 28 30 L24 27.5 L20 30 C19 26 16 25 13 28 C12 24 9 22 5 23 Z" />
          {asleep ? (
            <><path d="M20.6 21 q1.3 1.3 2.6 0" /><path d="M24.8 21 q1.3 1.3 2.6 0" /></>
          ) : (
            <><circle class="eye" cx="21.9" cy="21.4" r="1.1" /><circle class="eye" cx="26.1" cy="21.4" r="1.1" /></>
          )}
          <path d="M9 38 H39" stroke-dasharray="2 3.5" />
        </>
      )}
      {sign === 'heart' && (
        <>
          <path d="M24 40 C14 33 7 27 7 19 C7 14 11 10.5 15.5 10.5 C19.5 10.5 22 12.5 24 16 C26 12.5 28.5 10.5 32.5 10.5 C37 10.5 41 14 41 19 C41 27 34 33 24 40 Z" />
          {asleep ? (
            <><path d="M17.5 22 q2 2 4 0" /><path d="M26.5 22 q2 2 4 0" /></>
          ) : (
            <><circle class="eye" cx="19.5" cy="22.5" r="1.4" /><circle class="eye" cx="28.5" cy="22.5" r="1.4" /></>
          )}
        </>
      )}
      {sign === 'leg-veins' && (
        <>
          <rect x="27" y="9" width="12" height="13" rx="3" />
          <path d="M4 24 H44" />
          <circle cx="15" cy="34" r="6.5" />
          <ellipse cx="33" cy="30" rx="7.5" ry="2.8" />
          {asleep ? (
            <><path d="M12.4 33.5 q1.2 1.2 2.4 0" /><path d="M16.2 33.5 q1.2 1.2 2.4 0" /></>
          ) : (
            <><circle class="eye" cx="13.6" cy="34" r="1.1" /><circle class="eye" cx="17.4" cy="34" r="1.1" /></>
          )}
        </>
      )}
      {sign === 'fan' && (
        <>
          <path d="M24 10 L7.9 32.9 A28 28 0 0 0 40.1 32.9 Z" />
          <path d="M14.8 23.2 A16 16 0 0 0 33.2 23.2" />
          <path d="M11.4 28.1 A22 22 0 0 0 36.6 28.1" />
        </>
      )}
      {asleep && (
        <>
          <text x={zx} y={zy} font-size="8">z</text>
          <text x={sx} y={sy} font-size="6">z</text>
        </>
      )}
    </svg>
  </span>
)}

<style>
  .mascot { display: block; color: var(--amber); overflow: visible; }
  .asleep .mascot { color: var(--text-2); }
  .eye, text { fill: currentColor; stroke: none; }
  text { font-family: Georgia, serif; font-style: italic; }

  .tile {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tile.asleep { border-style: dashed; }
  .flyer { display: block; }
</style>
