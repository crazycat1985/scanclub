---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Mascot from '../components/Mascot.astro';

const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <header class="home-head">
    <p class="eyebrow brand">
      <img src="/icons/favicon.svg" alt="" width="22" height="22" />ScanClub
    </p>
    <h1>What are we scanning today?</h1>
  </header>

  <ul class="areas">
    {areas.map(({ id, data }) => {
      const meta = [data.screensFor, data.viewCount].filter(Boolean).join(' · ');
      return (
        <li>
          {data.status === 'ready' ? (
            <a class="card area" href={`/${id}/`}>
              <Mascot area={id} />
              <span class="area-text">
                <h2>{data.name}</h2>
                <span class="muted">{meta}</span>
              </span>
              <span class="area-go" aria-hidden="true">→</span>
            </a>
          ) : (
            <div class="card area area-soon" aria-disabled="true">
              <Mascot area={id} asleep />
              <span class="area-text">
                <h2>{data.name}</h2>
                <span class="muted">{meta}</span>
                <span class="soon">{['Coming soon', data.comingSoonNote].filter(Boolean).join(' · ')}</span>
              </span>
            </div>
          )}
        </li>
      );
    })}
  </ul>
</Layout>

<style>
  .home-head { margin: 8px 0 24px; }
  .brand { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .brand img { border-radius: 6px; }
  .areas { display: grid; gap: 12px; }
  .area {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 88px;
    padding: 16px;
    color: inherit;
    text-decoration: none;
  }
  .area-text { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .area h2 { font-size: 25px; }
  .area .muted { font-size: 15px; }
  .area-go { color: var(--amber); font-size: 24px; transition: transform 160ms ease; }
  a.area:active { border-color: var(--amber); }
  a.area:hover .area-go,
  a.area:active .area-go { transform: translateX(4px); }
  .area-soon h2 { color: var(--text-2); }
  .soon { font-size: 13px; font-style: italic; color: var(--text-2); }
</style>
